# FastAPI integration
# Keep mock mode enabled for the local Sovereign Workbench preview.
NEXT_PUBLIC_USE_MOCKS=true
# Set this to the deployed FastAPI origin when backend integration is enabled.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Optional request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Existing project-managed values are configured through Vercel.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
